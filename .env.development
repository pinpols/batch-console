# 演示模式：前端权限开到最大（ADMIN + 全量 authority 展示），且不强制登录、401 不整页跳登录。关闭改为 false 并重启 dev
# 与 VITE_AUTH_BYPASS 等价，任一为 true 即生效
VITE_DEMO_MODE=false

# 留空：请求使用相对路径 /api/...，由 Vite 开发服务器代理到真实后端（避免浏览器跨域）
VITE_API_BASE_URL=
# 后端根地址（无路径后缀）。与 console-api OpenAPI servers 一致；若你的服务在别的端口/主机请改此项后重启 npm run dev
VITE_DEV_PROXY_TARGET=http://localhost:18080
VITE_APP_TITLE=批量调度平台（开发）

# ---- 前端可观测性 ----
# Sentry DSN（留空则不加载 Sentry SDK）
VITE_SENTRY_DSN=
# 行为埋点上报端点
VITE_TELEMETRY_ENDPOINT=/api/console/telemetry/events
# 是否启用行为埋点（false 关闭）
VITE_TELEMETRY_ENABLED=true
