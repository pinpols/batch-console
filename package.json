{
  "name": "batch-console",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "vite",
    "gen:api": "bash scripts/gen-api-types.sh",
    "gen:api:check": "bash scripts/check-api-drift.sh",
    "check:version": "bash scripts/check-version-alignment.sh",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "check:comments": "node scripts/check-comment-language.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:env": "node scripts/check-env-governance.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:go-live-readiness": "node scripts/check-go-live-readiness-doc.mjs",
    "check:maintainability": "node scripts/check-maintainability.mjs",
    "check:readability-calls": "node scripts/check-readability-calls.mjs",
    "test:readability-calls": "node --test scripts/tests/readability-callsite.test.mjs",
    "check:baseline-expansion": "node scripts/check-governance-baseline-expansion.mjs",
    "test:baseline-expansion": "node --test scripts/tests/governance-baseline-expansion.test.mjs scripts/tests/staging-e2e-config.test.mjs scripts/tests/playwright-release-report.test.mjs",
    "check:test-fixture-sources": "node scripts/check-test-fixture-sources.mjs",
    "check:ui-complexity": "node scripts/check-ui-complexity.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:shell": "bash scripts/check-shell-scripts.sh",
    "check:changelog": "node scripts/check-changelog-sync.mjs",
    "verify:governance": "bash scripts/verify-governance.sh",
    "verify:local": "bash scripts/ci.sh",
    "compliance:sbom": "node scripts/generate-frontend-compliance.mjs",
    "compliance:check": "node scripts/check-compliance-drift.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test:typecheck": "node --test scripts/tests/typecheck-scope.test.mjs",
    "test:nginx-routing": "node --test scripts/tests/nginx-routing.test.mjs",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n-messages.mjs",
    "preflight:changed": "node scripts/local/preflight-changed.mjs --staged",
    "preflight:changed:all": "node scripts/local/preflight-changed.mjs --all",
    "check:health": "bash scripts/local/health-check.sh",
    "smoke:endpoints": "node scripts/local/fe-endpoint-smoke.mjs",
    "build": "npm run typecheck && node --experimental-strip-types scripts/check-i18n-messages.mjs && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write src/",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.mjs test --grep-invert @slow",
    "test:e2e:monitoring:real": "E2E_MONITORING_REAL=1 BC_E2E_SKIP_TEARDOWN=1 node scripts/run-playwright.mjs test e2e/monitoring-platform-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:slow": "node scripts/run-playwright.mjs test --grep @slow",
    "test:e2e:all": "node scripts/run-playwright.mjs test",
    "test:e2e:config": "node --test scripts/tests/staging-e2e-config.test.mjs",
    "test:e2e:ui": "node scripts/run-playwright.mjs test --ui",
    "test:e2e:headed": "node scripts/run-playwright.mjs test --headed",
    "test:e2e:visual": "node scripts/run-playwright.mjs test --config playwright.visual.config.cjs",
    "test:e2e:smoke": "node scripts/run-playwright.mjs test e2e/smoke.spec.ts e2e/cross-navigation.spec.ts e2e/navigation.spec.ts",
    "test:e2e:maintenance": "E2E_MAINTENANCE_EXCLUSIVE=1 node scripts/run-playwright.mjs test e2e/maintenance-recovery.spec.ts --workers=1",
    "docs:prepare": "node scripts/docs-prepare.mjs",
    "docs:build": "bash scripts/docs-build.sh",
    "docs:size": "node scripts/check-docs-bundle-size.mjs",
    "docs:preview": "vitepress preview tools/docs-bridge/frontend --host 127.0.0.1 --port 5174",
    "docs:serve": "bash scripts/docs-serve.sh",
    "//docs:dev:disabled": "统一站点使用生成的跨仓文档源目录；本地请用 npm run docs:serve(build + preview)",
    "dev:all": "concurrently -k -n SPA,DOCS -c blue,green \"npm:dev\" \"npm:docs:serve\"",
    "docker:build": "docker build --build-context backend-docs=../file-batch-system/docs -t batch-console:latest .",
    "docker:run": "docker run --rm -p 8080:8080 -e BACKEND_UPSTREAM_HOST=host.docker.internal:18080 --add-host=host.docker.internal:host-gateway batch-console:latest",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "size": "node scripts/check-bundle-size.mjs",
    "size:why": "node scripts/check-bundle-size.mjs --why",
    "test:e2e:quartz-progress:real": "E2E_QUARTZ_PROGRESS_REAL=1 node scripts/run-playwright.mjs test e2e/quartz-daily-progress-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:progress:real": "E2E_RUNTIME_PROGRESS_REAL=1 node scripts/run-playwright.mjs test e2e/runtime-progress-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:worker-progress:real": "E2E_WORKER_PROGRESS_REAL=1 node scripts/run-playwright.mjs test e2e/worker-workflow-progress-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:atomic-runtime:real": "E2E_ATOMIC_RUNTIME_REAL=1 node scripts/run-playwright.mjs test e2e/atomic-runtime-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:atomic-config:real": "E2E_ATOMIC_CONFIG_REAL=1 node scripts/run-playwright.mjs test e2e/atomic-task-config-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:oidc-bindings:real": "E2E_OIDC_IDENTITY_REAL=1 node scripts/run-playwright.mjs test e2e/oidc-identity-bindings-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:forensic:real": "E2E_FORENSIC_EXPORT_REAL=1 node scripts/run-playwright.mjs test e2e/forensic-export-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:result-versions:real": "E2E_RESULT_VERSION_GOVERNANCE_REAL=1 node scripts/run-playwright.mjs test e2e/result-version-governance-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:workflow-versions:real": "E2E_WORKFLOW_VERSIONS_REAL=1 node scripts/run-playwright.mjs test e2e/workflow-definition-versions-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:persistent-waits:real": "E2E_PERSISTENT_WAITS_REAL=1 node scripts/run-playwright.mjs test e2e/persistent-waits-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:scheduler-waits:real": "E2E_SCHEDULER_WAITS_REAL=1 node scripts/run-playwright.mjs test e2e/scheduler-dependency-waits-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:manual-upload:real": "E2E_MANUAL_FILE_UPLOAD_REAL=1 node scripts/run-playwright.mjs test e2e/manual-file-upload-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:batch-day:real": "E2E_BATCH_DAY_GOVERNANCE_REAL=1 node scripts/run-playwright.mjs test e2e/batch-day-governance-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:pipeline-progress:real": "E2E_PIPELINE_PROGRESS_REAL=1 node scripts/run-playwright.mjs test e2e/pipeline-progress-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:import-worker-progress:real": "E2E_IMPORT_WORKER_PROGRESS_REAL=1 node scripts/run-playwright.mjs test e2e/import-worker-pipeline-progress-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:workflow-node-replay:real": "E2E_WORKFLOW_NODE_REPLAY_REAL=1 node scripts/run-playwright.mjs test e2e/workflow-failed-node-replay-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:workflow-dag-branches:real": "E2E_WORKFLOW_DAG_BRANCHES_REAL=1 node scripts/run-playwright.mjs test e2e/workflow-dag-branches-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:multi-calendar-progress:real": "E2E_MULTI_CALENDAR_PROGRESS_REAL=1 node scripts/run-playwright.mjs test e2e/multi-calendar-daily-progress-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:whole-workflow-replay:real": "E2E_WHOLE_WORKFLOW_REPLAY_REAL=1 node scripts/run-playwright.mjs test e2e/workflow-whole-replay-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:process-worker-progress:real": "E2E_PROCESS_WORKER_PROGRESS_REAL=1 node scripts/run-playwright.mjs test e2e/process-worker-pipeline-progress-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:dispatch-worker-progress:real": "E2E_DISPATCH_WORKER_PROGRESS_REAL=1 node scripts/run-playwright.mjs test e2e/dispatch-worker-pipeline-progress-real.spec.ts --project=chromium --workers=1 --retries=0",
    "test:docs-publication": "node --test scripts/tests/docs-publication.test.mjs"
  },
  "dependencies": {
    "@antv/x6": "^3.1.8",
    "@antv/x6-vue-shape": "^3.0.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lucide/vue": "^1.57.0",
    "@sentry/vue": "^11.7.0",
    "@tanstack/vue-query": "^5.104.2",
    "axios": "^1.20.0",
    "codemirror": "6.0.2",
    "cronstrue": "^3.32.0",
    "dayjs": "1.11.23",
    "dompurify": "^3.4.17",
    "driver.js": "^1.9.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "eventsource-parser": "4.1.2",
    "json-bigint": "^1.0.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "svg-pan-zoom": "^3.6.2",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@playwright/test": "^1.64.1",
    "@sentry/cli": "^3.8.0",
    "@types/dagre": "^0.7.54",
    "@types/json-bigint": "^1.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.6",
    "dagre": "^0.8.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "mermaid": "^11.17.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "glob": "^13.0.6",
    "katex": "0.18.2",
    "shell-quote": "^1.12.0",
    "vitepress": {
      "esbuild": "^0.25.5",
      "vite": "^6.4.3"
    }
  },
  "lint-staged": {
    "src/**/*.{vue,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true,
    "fsevents@2.3.3": true,
    "@sentry/cli@3.8.0": true
  }
}
