{
  "name": "batch-console",
  "version": "0.1.7",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "vite",
    "gen:api": "openapi-typescript ../file-batch-system/docs/api/console-api.openapi.yaml -o src/types/api.generated.ts && prettier --write src/types/api.generated.ts",
    "gen:api:check": "bash scripts/check-api-drift.sh",
    "typecheck": "vue-tsc --noEmit",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n-messages.mjs",
    "check:health": "bash scripts/local/health-check.sh",
    "smoke:endpoints": "node scripts/local/fe-endpoint-smoke.mjs",
    "build": "vue-tsc && node --experimental-strip-types scripts/check-i18n-messages.mjs && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write src/",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @slow",
    "test:e2e:slow": "playwright test --grep @slow",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/cross-navigation.spec.ts e2e/navigation.spec.ts",
    "docs:prepare": "node scripts/docs-prepare.mjs",
    "docs:build": "npm run docs:prepare && vitepress build tools/docs-bridge/backend",
    "docs:preview": "vitepress preview tools/docs-bridge/backend --port 5174",
    "docs:serve": "npm run docs:build && npm run docs:preview",
    "//docs:dev:disabled": "vitepress 1.6.4 跨仓 srcDir+cleanUrls dev 模式所有目录入口 404(rewrites README.md→index.md 不生效),本地起文档必须 npm run docs:serve(= build + preview)",
    "fe-docs:build": "vitepress build tools/docs-bridge/frontend",
    "fe-docs:preview": "vitepress preview tools/docs-bridge/frontend --port 5175",
    "fe-docs:serve": "npm run fe-docs:build && npm run fe-docs:preview",
    "dev:all": "concurrently -k -n SPA,DOCS,FEDOCS -c blue,green,magenta \"npm:dev\" \"npm:docs:serve\" \"npm:fe-docs:serve\"",
    "docker:build": "docker build -t batch-console:latest .",
    "docker:run": "docker run --rm -p 8080:80 -e BACKEND_UPSTREAM_HOST=host.docker.internal:18080 --add-host=host.docker.internal:host-gateway batch-console:latest",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "size-limit": [
    {
      "name": "vendor-element-plus",
      "path": "dist/assets/vendor-element-plus-*.js",
      "limit": "340 KB"
    },
    {
      "name": "vendor-vue",
      "path": "dist/assets/vendor-vue-*.js",
      "limit": "60 KB"
    },
    {
      "name": "main (index)",
      "path": "dist/assets/index-*.js",
      "limit": "200 KB"
    }
  ],
  "dependencies": {
    "@antv/x6": "^3.1.7",
    "@antv/x6-vue-shape": "^3.0.2",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@sentry/vue": "^10.52.0",
    "@tanstack/vue-query": "^5.96.1",
    "axios": "^1.16.1",
    "codemirror": "^6.0.2",
    "cronstrue": "^3.14.0",
    "dompurify": "^3.4.0",
    "driver.js": "^1.4.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.14.1",
    "json-bigint": "^1.0.0",
    "pinia": "^3.0.4",
    "svg-pan-zoom": "^3.6.2",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.0.7",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-app": "^12.1.0",
    "@types/dagre": "^0.7.54",
    "@types/json-bigint": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "dagre": "^0.8.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "mermaid": "^11.14.0",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.7",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.1"
  },
  "lint-staged": {
    "src/**/*.{vue,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
