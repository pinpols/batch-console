#!/usr/bin/env sh
# main 只通过明确授权的 PR 交付；push hook 只保护 main，不创建 PR。
# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "禁止直接推送 main；请使用当前短期分支，并按显式交付请求创建 PR。" >&2
      exit 1
      ;;
  esac
done
