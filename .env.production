VITE_API_BASE_URL=/
VITE_APP_TITLE=批量调度平台
# 与后端 batch.timezone.default-zone 对齐；用户可在浏览器偏好中覆盖
VITE_DISPLAY_TIMEZONE=Asia/Shanghai

# ---- 前端可观测性 ----
# Sentry DSN（部署时填入实际地址，如 https://xxx@sentry.example.com/1）
VITE_SENTRY_DSN=
# 行为埋点上报端点
VITE_TELEMETRY_ENDPOINT=/api/console/telemetry/events
# 是否启用行为埋点。默认关闭；运行期可通过 localStorage.setItem('batch-console-telemetry','on') 临时打开
VITE_TELEMETRY_ENABLED=false
